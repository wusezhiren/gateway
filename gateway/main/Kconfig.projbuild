menu "Gateway"

    config GW_DEFAULT_CHANNEL
        int "ESP-NOW channel when no router is configured"
        range 1 13
        default 1
        help
            Once connected to a router, the gateway follows the router's channel
            and nodes find it by scanning.

    config GW_PROV_AP_PASSWORD
        string "Provisioning SoftAP password (8-63 chars, empty = random each time)"
        default "a12345678"

    config GW_LCD_BL_EXP_PIN
        int "TCA9554 pin controlling LCD backlight (-1 = unknown, only panel sleep)"
        range -1 7
        default -1
        help
            Screen-off turns this expander pin low. Use the console 'exp <pin> <0|1>'
            command to find which pin is the backlight on your board.

    config GW_SCREEN_OFF_S
        int "Default screen-off timeout in seconds (0 = always on)"
        default 60

    config GW_MAX_NODES
        int "Maximum number of paired nodes"
        range 1 14
        default 14
        help
            Limited by ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM; encrypted ESP-NOW peers and
            SoftAP clients share 17 hardware keys (3 are kept for provisioning).

    menu "Debug"
        config GW_TEST_ABORT_BEFORE_VALIDATE
            bool "Abort before marking OTA image valid (rollback test only)"
            default n
            help
                Builds a deliberately broken firmware: after an OTA it aborts before
                confirming itself, so the bootloader must roll back. Never ship this.
    endmenu

endmenu
