CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 控制台走芯片原生 USB（板上 USB 口）；改用 CH343 串口时换成 CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# 不签名、OTA 不校验签名：编译不需要 keys/signing_key.pem，签名过的旧固件也能升级上来
# 代价是拿到 token 的人能刷任意网关固件
# CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT is not set
# ESP-NOW 加密 peer 与 SoftAP 客户端共用 17 个硬件密钥：14 个给节点，3 个留给配网热点
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=14
# 手机联网检测的请求头较长，默认 512 会返回 431
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# 8MB Octal PSRAM（N16R8），LVGL 对象内存走 malloc 可用到 PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Only dropdown is used by the gateway UI; omit unused widgets to leave room
# in the 0x310000-byte OTA slots for WakeNet runtime code.
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_WIN=n
# lv_font_conv 生成的是 RLE 压缩字库，不开会在绘制文字时取到空位图崩溃
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_THEME_DEFAULT_DARK=y
# 内部 RAM 紧张（Wi-Fi、LVGL DMA 缓冲、MQTT TLS）：TLS 和 Wi-Fi/LWIP 缓冲放 PSRAM，
# 否则远程升级时第二条 TLS 连接（下载固件）申请不到内存
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# ESP-SR: load WakeNet model data from the Korvo SD card.
CONFIG_MODEL_IN_SDCARD=y
CONFIG_SR_WN_WN9S_NIHAOXIAOZHI=y
