CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 控制台走芯片原生 USB（板上 USB 口）；改用 CH343 串口时换成 CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# 签名镜像：不烧 eFuse，仅在 OTA 时校验签名
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="../keys/signing_key.pem"
# ESP-NOW 加密 peer 与 SoftAP 客户端共用 17 个硬件密钥：14 个给节点，3 个留给配网热点
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=14
# 手机联网检测的请求头较长，默认 512 会返回 431
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# 8MB Octal PSRAM（N16R8），LVGL 对象内存走 malloc 可用到 PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_QRCODE=y
# lv_font_conv 生成的是 RLE 压缩字库，不开会在绘制文字时取到空位图崩溃
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_THEME_DEFAULT_DARK=y
