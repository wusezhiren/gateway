menu "Node"

    config NODE_NAME
        string "Node name prefix (last 2 MAC bytes appended)"
        default "node"

    config NODE_RELAY_GPIOS
        string "Relay GPIOs, comma separated (empty = none)"
        default "4,5"

    config NODE_RELAY_ACTIVE_LOW
        bool "Relays are active low"
        default n

    config NODE_EXP_RELAY_PINS
        string "Relay channels on a TCA9554 I2C IO expander, pins 0..7 comma separated (empty = none)"
        default ""
        help
            For boards whose outputs sit behind an IO expander, e.g. the Korvo
            user LED GP_LED_2 on TCA9554 P7. Added after the GPIO relays.

    config NODE_EXP_ACTIVE_LOW
        bool "Expander outputs are active low"
        depends on NODE_EXP_RELAY_PINS != ""
        default n

    config NODE_EXP_I2C_SDA
        int "IO expander I2C SDA GPIO"
        depends on NODE_EXP_RELAY_PINS != ""
        default 17

    config NODE_EXP_I2C_SCL
        int "IO expander I2C SCL GPIO"
        depends on NODE_EXP_RELAY_PINS != ""
        default 18

    config NODE_PWM_GPIOS
        string "PWM GPIOs, comma separated (empty = none)"
        default "6"
        help
            PWM channels take values 0..1000 (per mille duty).

    config NODE_PWM_ACTIVE_LOW
        bool "PWM output inverted (e.g. LED to VCC)"
        default n

    config NODE_BREATH_GPIOS
        string "Breathing LED GPIOs, comma separated (empty = none)"
        default ""
        help
            Switch channels: while on, the LED fades in and out (3 s period).
            Driven by LEDC, polarity follows NODE_PWM_ACTIVE_LOW. Added after the PWM channels.

    config NODE_BLINK_GPIOS
        string "Slow blink LED GPIOs, comma separated (empty = none)"
        default ""
        help
            Switch channels: while on, the LED blinks 1 s on / 1 s off.
            Driven by LEDC, polarity follows NODE_PWM_ACTIVE_LOW. Added after the breathing LEDs.

    config NODE_RGB_GPIO
        int "WS2812 RGB LED GPIO, -1 for none"
        range -1 48
        default 48 if IDF_TARGET_ESP32S3
        default -1
        help
            One addressable RGB LED as a colour light channel, added after the PWM
            channels. Most ESP32-S3 core boards (DevKitC-1 v1.1, N16R8 core board)
            have it on GPIO48.

    config NODE_RESET_GPIO
        int "Button to forget gateway (hold 3 s), -1 to disable"
        range -1 48
        default 9 if IDF_TARGET_ESP32C3
        default 0

    config NODE_SLEEP_INTERVAL_S
        int "Deep sleep while all channels are off, wake every N seconds (0 = never sleep)"
        range 0 3600
        default 10
        help
            When every channel is off the node deep sleeps and wakes every N seconds to
            rejoin the gateway, which then delivers commands queued in the meantime, so
            commands take up to N seconds. Any channel on keeps the node awake. Not within
            30 s of power-on (time to flash over USB or hold the reset button), while unbound,
            during an OTA, or while the gateway asks it to stay awake.

    config NODE_TEST_NO_JOIN_AFTER_OTA
        bool "After an OTA, never contact the gateway (rollback test only)"
        default n
        help
            Builds a deliberately broken firmware: after an OTA it stays silent, so the
            validate timer must roll it back. Never ship this.

endmenu
