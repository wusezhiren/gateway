# 合宙 CORE-ESP32-C3 简约款（4MB flash，无串口芯片，走原生 USB）+ 单路低电平触发继电器，继电器通断 USB 灯条 5V
# 编译（工程名 esp_c3_relay，与通用 C3 节点固件区分，升级时不会互相刷错）：
#   idf.py -B build_c3relay -D SDKCONFIG=build_c3relay/sdkconfig -D NODE_PROJECT=esp_c3_relay \
#         -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.c3relay" set-target esp32c3 build
# 接线：继电器 IN -> GPIO4（右排 28 脚），VCC -> 3V3（26 脚），GND -> GND（25 脚）
#（低电平触发模块接 5V 时 3.3V 高电平可能关不断）
CONFIG_NODE_NAME="lamp"
CONFIG_NODE_RELAY_GPIOS="4"
CONFIG_NODE_RELAY_ACTIVE_LOW=y
# 板载 LED D4(GPIO12)、D5(GPIO13) 高电平点亮，作两路调光通道（继电器之后为 ch1、ch2）
CONFIG_NODE_PWM_GPIOS="12,13"
CONFIG_NODE_RGB_GPIO=-1
# 长按 BOOT 3 秒解绑
CONFIG_NODE_RESET_GPIO=9
# 板载 flash 是 DIO 接法，GPIO12/13 接板上 LED D4/D5，不能改成 QIO
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# 不签名、OTA 不校验签名：编译不需要 keys/signing_key.pem，正式签名的固件也能升级上来
# 代价是谁能经网关推 OTA 就能刷任意固件；其他节点仍要求签名
# CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT is not set
